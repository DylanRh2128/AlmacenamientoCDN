DATABASE_URL=postgresql://user:password@localhost:5432/files_db
API_KEY=choose-a-long-random-string-here

AWS_ACCESS_KEY_ID=your-iam-user-access-key
AWS_SECRET_ACCESS_KEY=your-iam-user-secret-key
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-private-bucket-name

CLOUDFRONT_DOMAIN=your-distribution-id.cloudfront.net
CLOUDFRONT_KEY_PAIR_ID=your-cloudfront-key-pair-id
# PEM contents of the CloudFront private key, with literal \n for line breaks
CLOUDFRONT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
